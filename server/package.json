{
  "name": "gravitylead-server",
  "version": "1.0.0",
  "description": "GravityLead missed-call text-back + SMS follow-up engine",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check": "for f in *.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js",
    "ci": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "node-cron": "^4.6.0",
    "twilio": "^5.4.0"
  }
}
