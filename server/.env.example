# ─────────────────────────────────────────────────────────────────────────────
# GravityLead Server — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Twilio credentials (required)
# Find these at console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key for /api/lead and /api/stats endpoints (required)
# Generate a strong random string: openssl rand -hex 32
API_KEY=replace_with_a_strong_random_secret

# Server
PORT=3000
BASE_URL=https://your-server.example.com

# Optional: Formspree passthrough (also sends lead to Formspree)
FORMSPREE_ENDPOINT=https://formspree.io/f/xdaqyezr

# Dashboard password (required for /dashboard)
# Visit https://your-server.com/dashboard — this is the password to log in.
# Generate a strong one: openssl rand -base64 18
DASHBOARD_PASSWORD=replace_with_a_strong_password

# Development only — set to "true" to skip Twilio webhook signature validation.
# NEVER set this in production. Twilio validation is always on when NODE_ENV=production.
# SKIP_TWILIO_VALIDATION=true
