# ─────────────────────────────────────────────────────────────────────────────
# GravityLead Server — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Twilio credentials (required)
# Find these at console.twilio.com → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key for /api/lead and /api/stats endpoints (required)
# Generate a strong random string: openssl rand -hex 32
API_KEY=replace_with_a_strong_random_secret

# Server
PORT=3000
BASE_URL=https://your-server.example.com

# Exact number of trusted reverse proxies (Render/Railway commonly use 1).
# Use 0 when Node is exposed directly.
TRUST_PROXY_HOPS=1

# Exact origins allowed to submit browser leads to /api/public/lead.
# Separate multiple origins with commas. Leave blank to disable public intake.
PUBLIC_LEAD_ORIGINS=https://getgravitylead.com,https://www.getgravitylead.com

# Optional: Formspree passthrough (also sends lead to Formspree)
FORMSPREE_ENDPOINT=https://formspree.io/f/xdaqyezr

# Dashboard password (required for /dashboard)
# Visit https://your-server.com/dashboard — this is the password to log in.
# Generate a strong one: openssl rand -base64 18
DASHBOARD_PASSWORD=replace_with_a_strong_password

# Telegram control bot (optional — enables /status, /clients, /leads, etc.)
# 1. Create a bot with @BotFather → copy the token here.
# 2. Get your numeric id from @userinfobot → set TELEGRAM_OWNER_ID.
# The bot only responds to TELEGRAM_OWNER_ID; all other users are ignored.
# Leave TELEGRAM_BOT_TOKEN blank to disable the bot entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Development only — set to "true" to skip Twilio webhook signature validation.
# NEVER set this in production. Twilio validation is always on when NODE_ENV=production.
# SKIP_TWILIO_VALIDATION=true

# ─────────────────────────────────────────────────────────────────────────────
# System Ops Dashboard (/ops) — all optional; omit to skip that check
# ─────────────────────────────────────────────────────────────────────────────

# OpenClaw Gateway URL (e.g. http://localhost:4000 or your hosted gateway)
OPENCLAW_GATEWAY_URL=https://your-openclaw-gateway.example.com

# GitHub repo for last-deploy info (format: owner/repo)
GITHUB_REPO=daveopenclaw35/gravitylead-template
# GitHub personal access token (optional — avoids 60 req/hr rate limit)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_live_replace_me

# UptimeRobot v2 API key — My Settings → API Settings → Main API Key
UPTIMEROBOT_API_KEY=ur1234567-replace_me

# Anthropic API key (used to verify the key is active)
ANTHROPIC_API_KEY=sk-ant-replace_me

# The ops dashboard reuses TELEGRAM_BOT_TOKEN from the bot section above.
